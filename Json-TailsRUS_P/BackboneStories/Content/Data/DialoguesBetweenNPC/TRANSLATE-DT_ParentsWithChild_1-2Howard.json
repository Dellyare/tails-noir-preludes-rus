[
  {
    "path": "Exports.0.Table.Data.0.Value.0",
    "key": "2981DC5545FA61D7425ABEBE473CCE95",
    "text": "...Расскажешь всё в выходные. Хорошо?",
    "originalText": "...And you can tell us all about it on the weekend. Alright?"
  },
  {
    "path": "Exports.0.Table.Data.1.Value.0",
    "key": "B2C429474D9DBD44BA6D08BA148C6DDA",
    "text": "Конечно-конечно. Не переживай так, я справлюсь.",
    "originalText": "Sure, sure. Don't worry so much, I'll be fine."
  },
  {
    "path": "Exports.0.Table.Data.2.Value.0",
    "key": "A989D1C443BCC940077CD8B1724E4763",
    "text": "Мы будем скучать, малыш.",
    "originalText": "We're going to miss you so much, baby."
  },
  {
    "path": "Exports.0.Table.Data.3.Value.0",
    "key": "A88A0700419221F3AA3C749723B80630",
    "text": "Знаю. Я тоже, мам.",
    "originalText": "I know. Me too, mom."
  },
  {
    "path": "Exports.0.Table.Data.4.Value.0",
    "key": "D072F955488C0CB71596BFBC61320C1D",
    "text": "Наш мальчик. Малыш Шем. Совсем взрослый.",
    "originalText": "Our little baby boy. Baby Sheamus. All grown up."
  },
  {
    "path": "Exports.0.Table.Data.5.Value.0",
    "key": "3D9A455E428D2D11ABD2F7AB802E83B8",
    "text": "Пап, ну…",
    "originalText": "Dad, come on..."
  }
]
